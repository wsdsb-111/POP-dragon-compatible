  "changes": [
    {
      "output": "mod/common/character_interactions/mm_wyvern_human_form.txt",
      "method": "Add one reversible interaction restricted to a living, tamed wyvern aged 10 or older and its actual bonded keeper. on_accept revalidates actor and recipient before it adds/removes mm_wyvern_human_form using supported character-flag effects."
    },
    {
      "output": "mod/common/scripted_guis/zzzz_multi_mod_wyvern_human_form.txt",
      "method": "Re-declare myv_wyvern_character_window with the existing myv_is_wyvern check and an additional NOT human-form flag, revealing the stock character panel while transformed."
    },
    {
      "output": "mod/gfx/portraits/portrait_modifiers/zzzz_multi_mod_wyvern_human_form.txt",
      "method": "Use supported weight conditions to skip the priority-1000 no-human-accessories selection in human form while preserving base 0 and the original three-trait OR. Put DNA modifiers directly under dna_modifiers as the regular portrait schema requires. Add a priority-2000 layer after the priority-110 color/size group to clear the wyvern body accessory and restore normal_portrait without mutating stored DNA."
    },
    {
      "output": "mod/gfx/portraits/trait_portrait_modifiers/zzzz_multi_mod_wyvern_human_form.txt",
      "method": "Re-declare the original wyvern trait modifier with the documented trait-entry trigger, disabling its no_portrait and body attachment in human form independently of portrait-group ordering."
    },
    {
      "output": "mod/localization/english/mm_wyvern_human_form_l_english.yml",
      "method": "Add the interaction label and description."
    },
    {
      "output": "mod/localization/simp_chinese/mm_wyvern_human_form_l_simp_chinese.yml",
      "method": "Add the interaction label and description."
    }
  ],
  "boundaries": [
    "Character identity, biological age, sex, parentage and wyvern abilities remain unchanged by the toggle.",
    "The first human transformation rolls three or four persistent feature traits once; later toggles do not reroll.",
    "Human-only accessories are isolated by feature and form flags; native dragon body, riding and flight remain separate.",
    "Adult and reduced 55-percent child horns/tail/scales use separate bone-node attachments; eye meshes remain native."
  ],
