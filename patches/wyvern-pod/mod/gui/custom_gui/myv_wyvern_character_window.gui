######################################################
############ MYTHICAL VANILLA WYVERN VIEW ############
######################################################

types CharacterWindow
{
	# The vanilla HUD stress bar is a hand-built textured meter rather than the
	# generic progressbar skin. Reuse its rough edge, scratches and moving cloud
	# layers while keeping the value bound exclusively to wyvern hunger.
	type myv_wyvern_hunger_fill = icon {
		texture = "gfx/interface/colors/green.dds"
		shaderfile = "gfx/FX/pdxgui_repeat_texture.shader"
		alpha = 0.9

		modify_texture = {
			texture = "gfx/interface/component_masks/mask_rough_edges.dds"
			spriteType = Corneredtiled
			spriteborder = { 20 20 }
			blend_mode = alphamultiply
			texture_density = 5
		}

		modify_texture = {
			texture = "gfx/interface/component_masks/mask_fade_horizontal.dds"
			blend_mode = alphamultiply
			alpha = 0.3
		}

		modify_texture = {
			texture = "gfx/interface/component_masks/mask_scratches.dds"
			blend_mode = alphamultiply
			spriteType = corneredtiled
			alpha = 0.3
			texture_density = 3
		}

		modify_texture = {
			name = "clouds"
			texture = "gfx/interface/component_masks/mask_clouds_solid.dds"
			blend_mode = mask
			spriteType = corneredtiled
			texture_density = 1
		}

		modify_texture = {
			texture = "gfx/interface/colors/gold.dds"
			blend_mode = colordodge
			alpha = 0.25
		}

		state = {
			name = hunger_flow_a
			next = hunger_flow_b
			trigger_on_create = yes
			duration = 2

			modify_texture = {
				name = "clouds"
				translate_uv = { 0 0 }
			}
		}

		state = {
			name = hunger_flow_b
			next = hunger_flow_a
			duration = 2

			modify_texture = {
				name = "clouds"
				translate_uv = { -1 0 }
			}
		}
	}

	# Every full-panel wyvern portrait uses the same compact identity/location
	# cooltip as the outliner instead of the unrestricted human character one.
	type myv_wyvern_character_portrait_button = portrait_button {
		using = portrait_base

		blockoverride "portrait_button_template_tooltip" {
			tooltip_visible = "[Not(IsInteractionMenuOpenForCharacter(Character.GetID))]"
			tooltipwidget = {
				myv_wyvern_outliner_cooltip = {}
			}
		}
	}

	type myv_wyvern_character_view = vbox {
		name = "myv_wyvern_character_content"
		using = Window_Margins_Sidebar
		visible = "[GetScriptedGui('myv_wyvern_character_window').IsShown( GuiScope.SetRoot( CharacterWindow.GetCharacter.MakeScope ).End )]"

		widget = {
			name = "myv_wyvern_portrait_area"
			datacontext = "[GetIllustration( 'myv_wyvern_wilderness' )]"
			layoutpolicy_horizontal = expanding
			size = { 0 434 }

			# Scene backgrounds share the same crop and mask so switching never
			# changes the portrait composition. A housed wyvern always uses the
			# stable; otherwise a resting wild wyvern uses its cave and roaming or
			# tamed wyverns use their current terrain.
			widget = {
				visible = "[GetScriptedGui('myv_wyvern_scene_stable').IsShown( GuiScope.SetRoot( Character.MakeScope ).End )]"
				size = { 100% 100% }
				background = {
					texture = "gfx/interface/illustrations/myv/myv_wyvern_background_stable.dds"
					fittype = centercrop
					alpha = 0.65
					modify_texture = {
						texture = "gfx/interface/component_masks/mask_rough_edges_down_right.dds"
						spriteType = Corneredtiled
						spriteborder = { 20 20 }
						blend_mode = alphamultiply
						texture_density = 2
					}
				}
			}

			widget = {
				visible = "[GetScriptedGui('myv_wyvern_scene_cave').IsShown( GuiScope.SetRoot( Character.MakeScope ).End )]"
				size = { 100% 100% }
				background = {
					texture = "gfx/interface/illustrations/myv/myv_wyvern_background_cave.dds"
					fittype = centercrop
					alpha = 0.65
					modify_texture = {
						texture = "gfx/interface/component_masks/mask_rough_edges_down_right.dds"
						spriteType = Corneredtiled
						spriteborder = { 20 20 }
						blend_mode = alphamultiply
						texture_density = 2
					}
				}
			}

			widget = {
				visible = "[GetScriptedGui('myv_wyvern_scene_snow').IsShown( GuiScope.SetRoot( Character.MakeScope ).End )]"
				size = { 100% 100% }
				background = {
					texture = "gfx/interface/illustrations/myv/myv_wyvern_background_snow.dds"
					fittype = centercrop
					alpha = 0.65
					modify_texture = {
						texture = "gfx/interface/component_masks/mask_rough_edges_down_right.dds"
						spriteType = Corneredtiled
						spriteborder = { 20 20 }
						blend_mode = alphamultiply
						texture_density = 2
					}
				}
			}

			widget = {
				visible = "[GetScriptedGui('myv_wyvern_scene_mountains').IsShown( GuiScope.SetRoot( Character.MakeScope ).End )]"
				size = { 100% 100% }
				background = {
					texture = "gfx/interface/illustrations/myv/myv_wyvern_background_mountains.dds"
					fittype = centercrop
					alpha = 0.65
					modify_texture = {
						texture = "gfx/interface/component_masks/mask_rough_edges_down_right.dds"
						spriteType = Corneredtiled
						spriteborder = { 20 20 }
						blend_mode = alphamultiply
						texture_density = 2
					}
				}
			}

			widget = {
				visible = "[GetScriptedGui('myv_wyvern_scene_desert').IsShown( GuiScope.SetRoot( Character.MakeScope ).End )]"
				size = { 100% 100% }
				background = {
					texture = "gfx/interface/illustrations/myv/myv_wyvern_background_desert.dds"
					fittype = centercrop
					alpha = 0.65
					modify_texture = {
						texture = "gfx/interface/component_masks/mask_rough_edges_down_right.dds"
						spriteType = Corneredtiled
						spriteborder = { 20 20 }
						blend_mode = alphamultiply
						texture_density = 2
					}
				}
			}

			widget = {
				visible = "[GetScriptedGui('myv_wyvern_scene_grassland').IsShown( GuiScope.SetRoot( Character.MakeScope ).End )]"
				size = { 100% 100% }
				background = {
					texture = "gfx/interface/illustrations/myv/myv_wyvern_background.dds"
					fittype = centercrop
					alpha = 0.65
					modify_texture = {
						texture = "gfx/interface/component_masks/mask_rough_edges_down_right.dds"
						spriteType = Corneredtiled
						spriteborder = { 20 20 }
						blend_mode = alphamultiply
						texture_density = 2
					}
				}
			}

			# Keep the hitbox smaller than the full panel so window controls remain clickable.
			myv_wyvern_character_portrait_button = {
				name = "myv_wyvern_portrait_tier_0"
				visible = "[And(Character.IsAlive, GetScriptedGui('myv_wyvern_uses_camera_tier_0').IsShown( GuiScope.SetRoot( Character.MakeScope ).End ))]"
				size = { 594 434 }
				position = { 0 0 }
				parentanchor = top|hcenter
				blockoverride "portrait_button_template_onrightclick" {
					onrightclick = "[ToggleFilteredCharacterInteractionMenu(Character.Self, 'myv_wyvern_interaction')]"
					button_ignore = none
				}
				portrait_texture = "[Character.GetAnimatedPortrait(Illustration.GetEnvironment(Character.Self), 'camera_myv_wyvern_character_tier_0', 'myv_wyvern_main', PdxGetWidgetScreenSize(PdxGuiWidget.Self))]"
				mask = "gfx/portraits/portrait_mask_character_view.dds"
				effectname = "NoHighlight"
				using = Animation_Character_Window_Refresh_Short
			}

			myv_wyvern_character_portrait_button = {
				name = "myv_wyvern_portrait_tier_0_memorial"
				visible = "[And(Not(Character.IsAlive), GetScriptedGui('myv_wyvern_uses_camera_tier_0').IsShown( GuiScope.SetRoot( Character.MakeScope ).End ))]"
